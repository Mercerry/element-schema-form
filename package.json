{
  "name": "@mercerry/element-schema-form",
  "version": "0.1.0",
  "description": "A schema-based form generator component for Element Plus.",
  "author": "mercerry <mercerry@outlook.com>",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.ts"
  },
  "main": "lib/element-schema-form.common.js",
  "module": "lib/element-schema-form.es.js",
  "exports": {
    ".": {
      "import": "./lib/element-schema-form.es.js",
      "require": "./lib/element-schema-form.common.js",
      "default": "./lib/element-schema-form.umd.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mercerry/element-schema-form.git"
  },
  "keywords": [
    "element",
    "json-schema",
    "form"
  ],
  "license": "MIT",
  "peerDependencies": {
    "element-plus": "^2.4.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "element-plus": "^2.4.0",
    "lodash.clonedeep": "^4.5.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "less": "^4.2.0",
    "normalize.css": "^8.0.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-router": "^4.2.0",
    "vue-tsc": "^1.8.0"
  }
}
